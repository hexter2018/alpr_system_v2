# ============================================================
# Thai ALPR — Environment Variables Reference
# ============================================================
# Copy to .env for local/non-Docker development, or override
# individual values in your shell before running docker compose.
#
# In Docker, these are injected via docker-compose.yml using
# the ${VAR:-default} syntax, so you only need to set the ones
# you want to override from the defaults shown below.
# ============================================================

# ── Core Infrastructure ──────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://alpr:alpr@localhost:5432/alpr
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./storage
MODEL_PATH=./models/best.pt

# ── JWT Authentication ───────────────────────────────────────
# IMPORTANT: Replace with a long random secret before deploying.
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_A_LONG_RANDOM_STRING
JWT_EXPIRE_MINUTES=480

# ── Telegram Alerts ──────────────────────────────────────────
# Leave blank to disable Telegram notifications.
# Obtain a bot token from @BotFather on Telegram, then add
# the bot to your group/channel and get the chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Data Retention (PDPA Compliance) ────────────────────────
# Delete captures + images older than this many days.
# Celery Beat dispatches the cleanup task daily at 02:00 BKK.
RETENTION_DAYS=90

# ── Logging ──────────────────────────────────────────────────
# true  → JSON structured logs (production, log aggregators)
# false → human-readable plain text (local development)
LOG_JSON=true

# ── ALPR Tuning ──────────────────────────────────────────────
MASTER_CONF_THRESHOLD=0.95
CORS_ORIGINS=http://localhost:5173

# ── MLOps / Training ─────────────────────────────────────────
# GPU to use for the trainer container (0 = first GPU).
# Set to 1 if you have two GPUs and want to dedicate one to training.
TRAINER_GPU=0
# Minimum mAP improvement required before a new YOLO model is deployed.
MIN_MAP_IMPROVEMENT=0.001
# Minimum new verified samples before a retraining run is triggered.
RETRAIN_THRESHOLD=1000

# ── Docker / Compose ─────────────────────────────────────────
# Must match the Docker Compose project name (default = parent dir name).
# Used by worker_restart.py to scope container discovery to this stack.
COMPOSE_PROJECT_NAME=alpr_system_v2

# ── Frontend (Vite build-time) ────────────────────────────────
# Base path for API calls baked into the compiled React bundle.
# In Docker production the nginx reverse-proxy routes /api → backend:8000,
# so /api is correct.  Override only if you're serving from a sub-path.
VITE_API_BASE=/api
